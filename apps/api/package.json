{
  "name": "@study-lab/api",
  "version": "1.0.0",
  "description": "Express learning service and demos",
  "main": "build/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && tsc",
    "build:swc": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && swc src -d build --strip-leading-paths",
    "build:swc:watch": "swc src -d build --strip-leading-paths --watch",
    "typecheck": "tsc --noEmit --incremental false --tsBuildInfoFile null",
    "start": "node --require dotenv/config --enable-source-maps build/index.js",
    "start:watch": "nodemon --watch build --ext js --exec 'pnpm start'",
    "dev": "concurrently -k \"tsc-watch --noClear\" \"pnpm start:watch\"",
    "start:dev": "tsx watch src/index.ts",
    "start:prod": "pnpm start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": "eslint --fix"
  },
  "dependencies": {
    "@study-lab/schema": "workspace:*",
    "compression": "1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "module-alias": "^2.3.4",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "^4.4.3",
    "zod-to-ts": "^2.1.0"
  },
  "devDependencies": {
    "@liangqingda/eslint-config": "^1.3.0",
    "@liangqingda/tsconfig": "^1.0.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "concurrently": "10.0.5",
    "eslint": "^9.39.4",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "nodemon": "3.1.14",
    "prettier": "^3.9.5",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
